# ==========================================================================
# Upscaler Pro — Environment configuration
# Copy to `.env` and edit. All values are optional; defaults shown below.
# ==========================================================================

# HTTP server
HOST=0.0.0.0
PORT=7860

# Frontend directory (absolute or relative to backend/)
FRONTEND_DIR=/app/frontend

# Real-ESRGAN model weights directory
MODEL_DIR=/app/backend/models

# Concurrency: how many images to upscale simultaneously.
# Set 1 for CPU-only hosts, 2-4 for GPU hosts with spare VRAM.
UPSCALER_CONCURRENCY=1

# Max single-file upload size in MB (server-enforced)
MAX_UPLOAD_MB=50

# Log level: debug | info | warning | error
LOG_LEVEL=info

# Optional: pin Real-ESRGAN model file name (under MODEL_DIR).
# Default: RealESRGAN_x4plus.pth
# Download: https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth
